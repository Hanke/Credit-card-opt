# Copy this file to backend/.env and adjust as needed. It is loaded by dotenv-rails
# in the development and test environments only (not in production) and is
# gitignored. Every variable below is optional: the defaults work for a local
# Postgres that trusts your OS user.

# Postgres connection override. Leave unset if `psql` connects with no password.
# Prefer the form WITHOUT a database name so config/database.yml still picks
# credit_card_opt_development or credit_card_opt_test per environment. Including
# a database name in the URL forces every environment (including tests) onto it.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432

# Origin allowed by CORS (config/initializers/cors.rb). Only matters when the
# browser talks to the API directly instead of through the Vite proxy.
# Default: http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# JWT signing key. Tokens are signed with Rails.application.secret_key_base, so
# there is no separate JWT_SECRET. In development and test Rails generates one
# automatically at tmp/local_secret.txt. In production set SECRET_KEY_BASE (or
# RAILS_MASTER_KEY to unlock config/credentials.yml.enc).
# SECRET_KEY_BASE=
