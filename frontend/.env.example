# Copy this file to frontend/.env and adjust as needed. Vite loads it
# automatically; only variables prefixed with VITE_ reach the browser.

# Base URL the browser uses for API calls (src/api/client.ts). Leave it empty in
# development: requests go to the same origin and vite.config.ts proxies /api/*
# to http://localhost:3000. Set it when the built app is served from a different
# origin than the API, e.g. https://api.example.com (no trailing slash), and set
# FRONTEND_ORIGIN on the backend to match the app's origin.
VITE_API_URL=
